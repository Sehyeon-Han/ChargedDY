universe = vanilla
executable = run_sumW.sh

arguments = $(filename) Muon_MC_200_2016_preVFP_$(jobidx).root

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

transfer_input_files = sumW.cc

output = logs_retry/job_$(Cluster)_$(jobidx).out
error  = logs_retry/job_$(Cluster)_$(jobidx).err
log    = logs_retry/job_$(Cluster).log

queue jobidx, filename from missing_jobs.txt